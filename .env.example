# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/creative_mastery"
# Auth.js: generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=""
# Needed from M3 onward. Without it the evaluation provider reports "not configured".
ANTHROPIC_API_KEY=""

# Required when running `next start` outside Vercel (local, CI, or behind your own proxy).
AUTH_TRUST_HOST=true

# Dev/staging only: show DRAFT and IN_REVIEW content to learners. Leave unset in production.
CONTENT_PREVIEW=true

# Learner uploads. Local-disk storage is DEV ONLY; production needs an object-store adapter.
UPLOAD_DIR=".data/uploads"

# AI assessment (M3). Without a key, submissions report "not configured" and no score is ever produced.
ANTHROPIC_API_KEY=""
# Defaults to claude-opus-5-5
EVALUATION_MODEL=""
# Max evaluations per learner per hour
EVAL_MAX_PER_HOUR=10
# TEST ONLY: deterministic evaluator that does not look at images. Requires ALLOW_FAKE_EVALUATOR=true outside NODE_ENV=test.
# EVALUATION_PROVIDER=fake
# ALLOW_FAKE_EVALUATOR=true

# Background assessment (M6). Run `npm run worker` next to the web app, or call POST /api/internal/jobs/tick on a schedule.
WORKER_CONCURRENCY=2
# Enables POST /api/internal/jobs/tick with `Authorization: Bearer <secret>`. Unset = endpoint returns 404.
# JOBS_TICK_SECRET=
# Pause assessment when today's (UTC) estimated spend reaches this many USD. Unset = no cap.
# EVAL_DAILY_BUDGET_USD=20
# List-price assumptions used to estimate spend from recorded token counts (USD per million tokens). Check your own pricing.
# EVAL_PRICE_IN_PER_MTOK=5
# EVAL_PRICE_OUT_PER_MTOK=25

# Rate limiting of public pages and images (M7). Believe x-forwarded-for only behind a proxy you control.
# TRUST_PROXY=true
# RATE_LIMIT_SALT=change-me
# RATE_PAGE_ANON_PER_MIN=120
# RATE_IMAGE_ANON_PER_MIN=300
# CONTENT_BLOCKLIST=comma,separated,terms

# Account security (M8). Email delivery: "smtp" (set SMTP_URL, e.g. smtps://user:pass@host:465, and MAIL_FROM) or "outbox"
# (DEV/TEST ONLY: writes mail to the EmailOutbox table; in production also needs ALLOW_OUTBOX_MAILER=true). Unset = no mail is sent.
# EMAIL_TRANSPORT=smtp
# SMTP_URL=
# MAIL_FROM="Creative Mastery <no-reply@example.com>"
# Public base URL used in emailed links.
# APP_URL=https://example.com
# Sign-in throttling (per 15 minutes) and other limits; defaults shown.
# AUTH_FAILS_PER_ACCOUNT=8
# AUTH_FAILS_PER_CLIENT=40
# AUTH_SIGNUPS_PER_CLIENT_HOUR=10
# AUTH_RESET_PER_CLIENT_HOUR=10
# AUTH_RESET_PER_ACCOUNT_HOUR=3
# AUTH_VERIFY_MAILS_PER_HOUR=3
# Send Strict-Transport-Security (only when the site is served over HTTPS).
# ENABLE_HSTS=true
